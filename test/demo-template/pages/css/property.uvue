<template>
	<scroll-view class="h-full bg-canvas" direction="vertical">
		<view class="detail-shell">
			<view class="detail-heading">
				<text class="eyebrow">{{ demo.category }} / CSS 用法</text>
				<text class="detail-title">{{ demo.title }}</text>
				<text class="detail-property">{{ demo.property }}</text>
				<text class="detail-description">{{ demo.description }}</text>
				<view class="support-note">
					<text class="text-sm text-muted">{{ demo.support }}</text>
				</view>
				<navigator
					:url="'/pages/webview?name=' + demo.property"
					class="official-link"
					hover-class="official-link-pressed"
				>
					<text class="text-sm leading-24 text-brand">查看 DCloud 官方说明 ↗</text>
				</navigator>
			</view>
			<view v-if="demo.cases.length === 0" class="notice-card">
				<text class="text-lg text-ink font-bold">当前端不支持这个属性</text>
				<text class="detail-description">
					可在支持的平台打开该属性页查看示例，支持范围见上方说明。
				</text>
			</view>
			<view v-else class="case-search">
				<text class="text-base font-bold text-ink">查找 Tailwind 写法</text>
				<input
					v-model="caseQuery"
					class="case-search-input"
					placeholder="例如 red-500、shadow-lg、变量"
				/>
				<text class="text-sm text-muted">
					匹配 {{ filteredCases.length }} / {{ demo.cases.length }} 例，已展示
					{{ visibleCases.length }} 例
				</text>
			</view>
			<view
				v-for="(sample, index) in visibleCases"
				:key="sample.className"
				class="example-card"
			>
				<view class="example-heading">
					<text class="example-number">
						{{ index + 1 < 10 ? '0' : '' }}{{ index + 1 }}
					</text>
					<text class="example-value">{{ sample.value }}</text>
				</view>
				<view class="code-panel">
					<text class="code-label">TAILWIND CLASS</text>
					<text class="code-text" user-select>{{ sample.className }}</text>
					<text class="css-text" user-select>
						{{
							sample.css ??
							(demo.property === 'lines' ? '-webkit-line-clamp' : demo.property) +
								': ' +
								sample.value +
								';'
						}}
					</text>
				</view>
				<text v-if="sample.note.length > 0" class="case-note">{{ sample.note }}</text>
				<view class="preview-panel">
					<text class="preview-label">效果预览</text>
					<view
						v-if="demo.kind === 'align-content'"
						class="wrap-stage flex-wrap"
						:class="sample.className"
					>
						<view v-for="n in 6" :key="n" class="wrap-item">
							<text class="item-label">{{ n }}</text>
						</view>
					</view>
					<view
						v-else-if="demo.kind === 'align-items'"
						class="row-stage"
						:class="sample.className"
					>
						<view class="align-item h-40">
							<text class="text-[14px] text-[#ffffff]">Aa</text>
						</view>
						<view class="align-item h-72">
							<text class="text-[28px] text-[#ffffff]">Bb</text>
						</view>
						<view class="align-item">
							<text class="text-[18px] text-[#ffffff]">Cc</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'align-self'" class="row-stage items-start">
						<view class="align-item h-40 bg-[#64748b]">
							<text class="item-label">1</text>
						</view>
						<view class="align-item" :class="sample.className">
							<text class="item-label">2</text>
						</view>
						<view class="align-item h-64 bg-[#64748b]">
							<text class="item-label">3</text>
						</view>
					</view>
					<view
						v-else-if="demo.kind === 'justify' || demo.kind === 'direction'"
						class="row-stage"
						:class="sample.className"
					>
						<view v-for="n in 3" :key="n" class="number-item">
							<text class="item-label">{{ n }}</text>
						</view>
					</view>
					<view
						v-else-if="demo.kind === 'wrap'"
						class="wrap-stage"
						:class="sample.className"
					>
						<view v-for="n in 6" :key="n" class="number-item w-88">
							<text class="item-label">{{ n }}</text>
						</view>
					</view>
					<view v-else-if="isFlexPreview" class="flex-stage">
						<view
							class="flex-reference"
							:class="
								demo.kind === 'shrink'
									? 'w-110 shrink'
									: demo.kind === 'grow'
										? 'w-40 grow'
										: 'grow'
							"
						>
							<text class="item-label">1</text>
						</view>
						<view
							class="flex-subject"
							:class="[sample.className, demo.kind === 'grow' ? 'w-40' : '']"
						>
							<text class="item-label">2</text>
						</view>
						<view
							class="flex-reference"
							:class="
								demo.kind === 'shrink'
									? 'w-110 shrink'
									: demo.kind === 'grow'
										? 'w-40 grow'
										: 'grow'
							"
						>
							<text class="item-label">3</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'visibility'" class="flex-stage">
						<view class="number-item bg-[#64748b]">
							<text class="item-label">1</text>
						</view>
						<view class="number-item" :class="sample.className">
							<text class="item-label">2</text>
						</view>
						<view class="number-item bg-[#64748b]">
							<text class="item-label">3</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'position' && sample.value === 'fixed'">
						<button class="action-button" @click="fixedVisible = !fixedVisible">
							{{ fixedVisible ? '关闭固定元素' : '显示固定元素' }}
						</button>
						<view v-if="fixedVisible" class="fixed-example" :class="sample.className">
							<text class="item-label">fixed：固定在页面右上方</text>
							<button class="fixed-close" @click="fixedVisible = false">关闭</button>
						</view>
					</view>
					<!-- #ifdef WEB -->
					<view
						v-else-if="demo.kind === 'position' && sample.value === 'sticky'"
						class="sticky-scroller"
					>
						<view class="h-60">
							<text class="text-sm text-muted">向下滚动预览区域</text>
						</view>
						<view class="sticky-subject" :class="sample.className">
							<text class="item-label">sticky / top: 0</text>
						</view>
						<view class="h-240">
							<text class="text-sm text-muted">滚动内容</text>
						</view>
					</view>
					<!-- #endif -->
					<view
						v-else-if="demo.kind === 'position' || demo.kind === 'offset'"
						class="position-stage"
					>
						<text class="position-caption">定位参照框</text>
						<view
							class="position-subject"
							:class="[
								sample.className,
								demo.kind === 'offset' ? 'absolute' : 'top-24 left-24',
								demo.property === 'top' || demo.property === 'bottom'
									? 'left-24'
									: '',
								demo.property === 'left' || demo.property === 'right'
									? 'top-24'
									: ''
							]"
						>
							<text class="item-label">A</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'layer'" class="position-stage">
						<view class="layer-reference"><text class="item-label">z: 10</text></view>
						<view class="layer-subject" :class="sample.className">
							<text class="item-label">{{ sample.value }}</text>
						</view>
					</view>
					<view
						v-else-if="demo.kind === 'overflow'"
						class="overflow-stage"
						:class="sample.className"
					>
						<view class="overflow-content">
							<text class="item-label">内容超出边界</text>
							<text class="item-label mt-72">这行在边界之外</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'pointer'" class="pointer-stage">
						<button class="pointer-button" @click="tapMessage = '下层按钮收到点击'">
							点击下层按钮
						</button>
						<view
							class="pointer-cover"
							:class="sample.className"
							@click="tapMessage = '覆盖层收到点击'"
						>
							<text class="item-label">
								{{ sample.value === 'none' ? '点击穿透到下层' : '覆盖层拦截点击' }}
							</text>
						</view>
					</view>
					<view
						v-else-if="demo.kind === 'size' || demo.kind === 'constraint'"
						class="size-stage"
					>
						<view
							class="size-subject"
							:class="[
								sample.className,
								demo.kind === 'constraint'
									? demo.property.startsWith('min')
										? 'w-40 h-40'
										: 'w-220 h-180'
									: ''
							]"
						>
							<text class="item-label">Size</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'margin'" class="spacing-stage">
						<view class="margin-subject" :class="sample.className">
							<text class="item-label">margin</text>
						</view>
						<view class="spacing-reference">
							<text class="text-sm text-muted">后续元素</text>
						</view>
					</view>
					<view
						v-else-if="demo.kind === 'padding'"
						class="padding-stage"
						:class="sample.className"
					>
						<view class="padding-content">
							<text class="item-label">内容区域</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'box-sizing'" class="size-stage">
						<view class="box-model" :class="sample.className">
							<text class="item-label">160px</text>
						</view>
						<view class="box-ruler">
							<text class="text-sm text-muted">参照：160px</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'backdrop'" class="backdrop-stage">
						<text class="backdrop-word">Tailwind</text>
						<view class="backdrop-color"></view>
						<view class="backdrop-cover" :class="sample.className">
							<text class="item-label">半透明覆盖层</text>
						</view>
					</view>
					<view v-else-if="isPaintPreview" class="paint-stage">
						<view
							class="paint-subject"
							:class="[
								sample.className,
								demo.kind === 'clip' ? 'clip-subject' : '',
								demo.kind.startsWith('border') ? 'bg-surface' : '',
								demo.kind === 'shadow' ? 'bg-[#ffffff]' : '',
								borderPreviewClasses[demo.property] ?? ''
							]"
						>
							<text
								class="item-label"
								:class="
									demo.kind.startsWith('border')
										? 'text-ink'
										: demo.kind === 'shadow'
											? 'text-[#172033]'
											: ''
								"
							>
								Tailwind
							</text>
						</view>
					</view>
					<view
						v-else-if="demo.kind === 'transform' || demo.kind === 'origin'"
						class="transform-stage"
					>
						<view class="transform-outline"></view>
						<view
							class="transform-subject"
							:class="[
								sample.className,
								demo.kind === 'origin' ? '[transform:rotate(25deg)]' : ''
							]"
						>
							<text class="item-label">Transform</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'transition'" class="transition-stage">
						<view
							class="transition-subject"
							:class="[sample.className, changed ? 'transition-changed' : '']"
						>
							<text class="item-label">{{ changed ? 'B' : 'A' }}</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'animation'" class="animation-stage">
						<view
							:key="replayKey"
							class="animation-subject"
							:class="[
								sample.className,
								demo.property === 'animation-fill-mode'
									? '[animation-iteration-count:1] [animation-delay:1000ms]'
									: ''
							]"
							:style="
								demo.property === 'animation-play-state'
									? running
										? {}
										: { animationPlayState: 'paused' }
									: { animationPlayState: running ? 'running' : 'paused' }
							"
						>
							<text class="item-label">Move</text>
						</view>
					</view>
					<!-- #ifdef WEB -->
					<view v-else-if="demo.kind === 'composition'" class="animation-stage">
						<view
							:key="replayKey"
							class="composition-subject"
							:class="sample.className"
							:style="{ animationPlayState: running ? 'running' : 'paused' }"
						>
							<text class="item-label">Compose</text>
						</view>
					</view>
					<view v-else-if="demo.kind === 'timeline'" class="timeline-scroller">
						<text class="text-sm text-muted">在此区域上下滚动</text>
						<view class="h-150"></view>
						<view class="timeline-subject" :class="sample.className">
							<text class="item-label">Scroll</text>
						</view>
						<view class="h-220"></view>
					</view>
					<!-- #endif -->
					<view v-else-if="demo.property === 'color'" class="color-stage">
						<view class="color-background bg-[#ffffff]">
							<text class="color-sample" :class="sample.className">
								Tailwind · 浅底
							</text>
						</view>
						<view class="color-background bg-[#142238]">
							<text class="color-sample" :class="sample.className">
								Tailwind · 深底
							</text>
						</view>
					</view>
					<view v-else class="text-stage">
						<text
							class="text-subject"
							:class="[
								sample.className,
								demo.kind === 'decoration' ? 'underline' : '',
								demo.kind === 'text-overflow'
									? 'overflow-hidden whitespace-nowrap w-full'
									: '',
								demo.kind === 'word-break' ? 'w-full' : ''
							]"
						>
							{{ previewText(sample.value) }}
						</text>
					</view>
				</view>
				<view v-if="demo.kind === 'transition'" class="control-row">
					<button class="action-button" @click="changed = !changed">切换 A / B</button>
				</view>
				<view
					v-if="demo.kind === 'animation' || demo.kind === 'composition'"
					class="control-row"
				>
					<button class="action-button" @click="running = !running">
						{{ running ? '暂停动画' : '开始动画' }}
					</button>
					<button class="secondary-button" @click="replay">重新播放</button>
				</view>
			</view>
			<button
				v-if="visibleCases.length < filteredCases.length"
				class="action-button"
				@click="visibleCount += 12"
			>
				继续展示 12 例
			</button>
			<text
				v-if="demo.cases.length > 0 && filteredCases.length === 0"
				class="detail-description"
			>
				没有找到对应写法，换个关键词试试。
			</text>
			<text v-if="demo.kind === 'pointer'" class="tap-feedback">{{ tapMessage }}</text>
			<text class="detail-footer">
				观察对象使用当前工具类。示例值不代表所有设备的最终表现。
			</text>
		</view>
	</scroll-view>
</template>

<script setup lang="ts">
import { computed, ref, watch } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { cssDemos } from './catalog'

const demo = ref(cssDemos[0])
// TODO: 待后续官方修复该bug后再删除对应描述。
// HX SDK 5.33、5.34 在不加载本插件时也会误判换行开头的条件；计算属性避免格式化触发该问题。
const isFlexPreview = computed(() => {
	const kind = demo.value.kind
	return kind === 'flex' || kind === 'grow' || kind === 'shrink' || kind === 'basis'
})
const isPaintPreview = computed(() => {
	const kind = demo.value.kind
	return (
		kind === 'paint' ||
		kind === 'shadow' ||
		kind === 'clip' ||
		kind === 'border' ||
		kind === 'border-color' ||
		kind === 'border-style' ||
		kind === 'border-width' ||
		kind === 'radius'
	)
})
const caseQuery = ref('')
const visibleCount = ref(12)
// 默认只创建一批预览节点，其他写法可搜索或分批展示，控制首次渲染开销。
const filteredCases = computed(() => {
	const keyword = caseQuery.value.trim().toLowerCase()
	return demo.value.cases.filter((sample) =>
		(sample.className + ' ' + sample.value + ' ' + sample.note).toLowerCase().includes(keyword)
	)
})
const visibleCases = computed(() => filteredCases.value.slice(0, visibleCount.value))
watch(caseQuery, () => {
	visibleCount.value = 12
})
const changed = ref(false)
const running = ref(false)
const replayKey = ref(0)
const fixedVisible = ref(false)
const tapMessage = ref('点击预览区，查看事件接收位置')

// 只补齐当前方向缺少的边框属性，避免公共四边框覆盖示例或干扰预览。
const borderPreviewClasses: Record<string, string> = {
	'border-color': 'border-4',
	'border-style': '[border-width:4px] border-[#0d9488]',
	'border-width': 'border-[#0d9488]',
	'border-top-color': 'border-t-4',
	'border-top-style': '[border-top-width:4px] border-t-[#0d9488]',
	'border-top-width': 'border-t-[#0d9488]',
	'border-right-color': 'border-r-4',
	'border-right-style': '[border-right-width:4px] border-r-[#0d9488]',
	'border-right-width': 'border-r-[#0d9488]',
	'border-bottom-color': 'border-b-4',
	'border-bottom-style': '[border-bottom-width:4px] border-b-[#0d9488]',
	'border-bottom-width': 'border-b-[#0d9488]',
	'border-left-color': 'border-l-4',
	'border-left-style': '[border-left-width:4px] border-l-[#0d9488]',
	'border-left-width': 'border-l-[#0d9488]'
}

onLoad((options) => {
	const found = cssDemos.find((item) => item.property === options['name'])
	if (found == null) {
		uni.showToast({ title: '未找到该 CSS 属性', icon: 'none' })
		return
	}
	demo.value = found
	uni.setNavigationBarTitle({ title: found.title })
})

/** 重建动画节点，从首帧重新播放，有限次动画也可重复观察。 */
function replay() {
	replayKey.value++
	running.value = true
}

/** 文本布局使用真实换行和长单词，避免只有一行而看不出属性效果。 */
function previewText(value: string): string {
	if (demo.value.property === 'font-family' && value === 'uni-icon')
		return '\ue601  \ue603  \ue604'
	if (demo.value.kind === 'whitespace') return 'Tailwind    CSS\n让每个  写法  都看得见效果。'
	if (demo.value.kind === 'word-break') return 'Supercalifragilisticexpialidocious TailwindCSS'
	if (demo.value.kind === 'multiline')
		return 'Tailwind CSS 让样式更直接。预览文字使用当前工具类。多行文字让行高、对齐和截断效果更容易观察。'
	if (demo.value.kind === 'text-overflow')
		return 'Tailwind CSS · 这是一段超过容器宽度的单行文本 · 观察首尾'
	return 'Tailwind CSS\n让样式更直接'
}
</script>

<style>
.detail-shell {
	@apply mx-auto w-full max-w-880 p-20;
}
.detail-heading {
	@apply mb-24;
}
.eyebrow {
	@apply text-sm text-brand font-medium mb-12;
}
.detail-title {
	@apply text-[28px] leading-38 text-ink font-bold;
}
.detail-property {
	@apply mt-8 text-lg text-muted;
}
.detail-description {
	@apply mt-14 text-base text-muted;
}
.support-note {
	@apply mt-16 p-12 rounded-[12px] bg-surface border border-solid border-line;
}
.official-link {
	@apply mt-12 min-h-48 justify-center self-start;
}
.official-link-pressed {
	@apply opacity-70;
}
.notice-card {
	@apply p-24 bg-surface rounded-[20px] border border-solid border-line;
}
.case-search {
	@apply mb-20 p-16 rounded-[16px] bg-surface border border-solid border-line;
}
.case-search-input {
	@apply my-12 h-48 px-12 text-base text-ink bg-canvas rounded-[12px] border border-solid border-line;
}
.example-card {
	@apply mb-20 rounded-[20px] bg-surface border border-solid border-line overflow-hidden;
}
.example-heading {
	@apply flex-row items-center p-18;
}
.example-number {
	@apply mr-12 text-sm text-brand font-bold;
}
.example-value {
	@apply flex-1 text-base text-ink font-medium break-all;
}
.code-panel {
	@apply mx-16 p-16 bg-[#142238] rounded-[12px];
}
.code-label {
	@apply text-[12px] leading-18 text-[#a6b7d0] mb-8;
}
.code-text {
	@apply text-[16px] leading-26 text-[#65e4c1] break-all;
}
.css-text {
	@apply mt-8 text-[13px] leading-22 text-[#d2dced] break-all;
}
.case-note {
	@apply px-18 pt-12 text-sm text-muted;
}
.preview-panel {
	@apply m-16 p-16 rounded-[12px] bg-canvas overflow-visible;
}
.preview-label {
	@apply mb-16 text-sm text-muted;
}
.row-stage {
	@apply flex-row w-240 h-160 bg-[#dce7f5] overflow-visible;
}
.wrap-stage {
	@apply flex-row w-240 h-168 bg-[#dce7f5] overflow-visible;
}
.wrap-item {
	@apply w-80 min-h-40 shrink-0 items-center justify-center bg-[#2563eb] border border-solid border-[#dce7f5];
}
.align-item {
	@apply w-72 min-h-32 bg-[#2563eb] justify-center items-center border border-solid border-[#dce7f5];
}
.number-item {
	@apply w-56 h-44 shrink-0 bg-[#2563eb] items-center justify-center border border-solid border-[#dce7f5];
}
.item-label {
	@apply text-[14px] leading-22 text-[#ffffff] text-center;
