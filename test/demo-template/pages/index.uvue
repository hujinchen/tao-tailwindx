	@apply text-[28px] leading-[36px] font-bold text-[#65e4c1];
}
.stat-label {
	@apply mt-[4px] text-sm text-[#c0ccdf];
}
.search-card {
	@apply mt-[20px] p-[20px] rounded-[20px] bg-surface border border-solid border-line;
}
.search-input {
	@apply my-[12px] h-[48px] px-[14px] text-base text-ink bg-canvas rounded-[12px] border border-solid border-line;
}
.category-section {
	@apply mt-[28px];
}
.category-heading {
	@apply flex-row items-center justify-between mb-[12px] px-[4px];
}
.category-title {
	@apply text-lg text-ink font-bold;
}
.category-count {
	@apply text-sm text-muted;
}
.category-card {
	@apply rounded-[18px] overflow-hidden bg-surface border border-solid border-line;
}
.property-link {
	@apply flex-row items-center min-h-[76px] px-[18px] py-[14px] border-b border-solid border-line;
}
.property-link-pressed {
	@apply bg-canvas;
}
.property-name {
	@apply text-base text-ink font-medium mb-[3px];
}
.property-badge {
	@apply ml-[8px] px-[10px] py-[5px] rounded-[8px] bg-canvas text-sm text-muted;
}
