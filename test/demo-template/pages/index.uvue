<template>
	<scroll-view class="h-full bg-canvas" direction="vertical">
		<view class="home-shell">
			<view class="home-hero">
				<view class="hero-mark p-[12px]">
					<text class="text-lg text-[#2563eb]">CSS → Tailwind</text>
				</view>
				<text class="hero-title">让每个写法，</text>
				<text class="hero-title">都有看得见的效果。</text>
				<text class="hero-description">uni-app x 官方 CSS 的 Tailwind 用法手册</text>
				<view class="hero-stats">
					<view class="stat-item">
						<text class="stat-number">{{ cssDemos.length }}</text>
						<text class="stat-label">CSS 属性</text>
					</view>
					<view class="stat-item">
						<text class="stat-number">{{ totalCases }}</text>
						<text class="stat-label">当前端示例</text>
					</view>
					<view class="stat-item">
						<text class="stat-number">{{ categories.length }}</text>
						<text class="stat-label">用法分类</text>
					</view>
				</view>
			</view>
			<view class="search-card">
				<text class="text-(--accent) font-bold">查找一个 CSS 属性</text>
				<input
					v-model="query"
					class="search-input"
					placeholder="例如 align-content、圆角、动画"
					aria-label="搜索 CSS 属性或用法"
				/>
				<text class="text-sm text-muted">
					每项包含写法、效果与使用条件。端差异请看属性页说明。
				</text>
			</view>
			<view v-for="group in groups" :key="group.title" class="category-section">
				<view class="category-heading">
					<text class="category-title">{{ group.title }}</text>
					<text class="category-count">{{ group.items.length }} 项</text>
				</view>
				<view class="category-card">
					<navigator
						v-for="demo in group.items"
						:key="demo.property"
						:url="'/pages/css/property?name=' + demo.property"
						class="property-link"
						hover-class="property-link-pressed"
					>
						<view class="flex-1">
							<text class="property-name">{{ demo.property }}</text>
							<text class="text-sm text-muted">{{ demo.title }}</text>
						</view>
						<text class="property-badge">{{ demo.cases.length }} 例</text>
						<text class="property-arrow">›</text>
					</navigator>
				</view>
			</view>
			<text v-if="groups.length === 0" class="empty-hint">
				没有找到相关属性，换个关键词试试。
			</text>
			<text class="footer-note">
				以 DCloud 官方 CSS 文档为依据 · 当前端不支持的示例会隐藏
			</text>
		</view>
	</scroll-view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { cssDemos } from './css/catalog'

const query = ref('')
const categories = [
	'弹性布局',
	'布局与层级',
	'尺寸与间距',
	'背景与效果',
	'边框与圆角',
	'文字排版',
	'变换与动效',
	'Web 扩展'
]
const totalCases = cssDemos.reduce((sum, demo) => sum + demo.cases.length, 0)
const groups = computed(() => {
	const keyword = query.value.trim().toLowerCase()
	return categories
		.map((title) => ({
			title,
			items: cssDemos.filter(
				(demo) =>
					demo.category === title &&
					(demo.property + demo.title + demo.category).toLowerCase().includes(keyword)
			)
		}))
		.filter((group) => group.items.length > 0)
})
</script>

